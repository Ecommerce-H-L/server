        {
          "name": "Log out",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tests tab (Minimal) — remove stored tokens from environment\r",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {\r",
                  "  // Unset environment vars\r",
                  "  pm.environment.unset('accessToken');\r",
                  "  pm.environment.unset('refreshToken');\r",
                  "\r",
                  "  pm.test('Logout succeeded and tokens removed', () => {\r",
                  "    pm.expect(pm.environment.get('accessToken')).to.be.oneOf([null, undefined]);\r",
                  "    pm.expect(pm.environment.get('refreshToken')).to.be.oneOf([null, undefined]);\r",
                  "  });\r",
                  "} else {\r",
                  "  pm.test('Logout failed', () => {\r",
                  "    pm.expect.fail(`Logout returned ${pm.response.code}`);\r",
                  "  });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"refreshToken\": \"{{refreshToken}}\"\r\n}",
              "options": {
                "raw": {
