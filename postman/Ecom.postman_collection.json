    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// --- Parse response (email/id come from here) ---\r",
                  "let res = {};\r",
                  "try { res = pm.response.json(); } catch (_) {}\r",
                  "\r",
                  "const newId    = res?.data?.id;\r",
                  "const newEmail = res?.data?.email;\r",
                  "\r",
                  "// --- Read password from the request body (not returned by API) ---\r",
                  "function getReqField(name) {\r",
                  "  const body = pm.request.body;\r",
                  "\r",
                  "  if (!body) return undefined;\r",
                  "\r",
                  "  // raw JSON\r",
                  "  if (body.mode === 'raw' && body.raw) {\r",
                  "    try {\r",
                  "      const json = JSON.parse(body.raw);\r",
                  "      return json?.[name];\r",
                  "    } catch { /* ignore */ }\r",
                  "  }\r",
                  "\r",
                  "  // x-www-form-urlencoded\r",
                  "  if (body.mode === 'urlencoded' && body.urlencoded) {\r",
                  "    const item = body.urlencoded.find(i => !i.disabled && i.key === name);\r",
                  "    return item?.value;\r",
                  "  }\r",
                  "\r",
                  "  // form-data\r",
                  "  if (body.mode === 'formdata' && body.formdata) {\r",
                  "    const item = body.formdata.find(i => !i.disabled && i.key === name);\r",
                  "    return item?.value;\r",
                  "  }\r",
                  "\r",
                  "  return undefined;\r",
                  "}\r",
                  "\r",
                  "const newPassword =\r",
                  "  getReqField('password') ??\r",
                  "  getReqField('confirmPassword'); // if you sent confirmPassword\r",
                  "\r",
                  "// --- Save to the CURRENT ENVIRONMENT ---\r",
                  "if (newEmail) pm.environment.set('newAccountEmail', newEmail);\r",
                  "if (newPassword) pm.environment.set('newAccountPassword', newPassword);\r",
                  "if (newId) pm.environment.set('newAccountId', newId);\r",
                  "\r",
                  "// --- Basic checks so you notice if something changed ---\r",
                  "pm.test('Stored new account credentials', function () {\r",
                  "  pm.expect(pm.environment.get('newAccountEmail'), 'email').to.be.a('string');\r",
                  "  pm.expect(pm.environment.get('newAccountPassword'), 'password').to.be.a('string');\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstName\": \"Long\",\r\n    \"lastName\": \"Truong\",\r\n    \"email\": \"longtruong26040212@gmail.com\",\r\n    \"role\": \"ADMIN\",\r\n    \"password\": \"123456789\",\r\n    \"confirmedPassword\": \"123456789\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Ensure JSON\r",
                  "let json = {};\r",
                  "try { json = pm.response.json(); } catch (e) { /* ignore */ }\r",
                  "\r",
                  "// Basic assertion (optional)\r",
                  "pm.test('Created (201)', function () {\r",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "// Pull tokens from your exact shape\r",
                  "const accessToken  = json?.data?.accessToken;\r",
                  "const refreshToken = json?.data?.refreshToken;\r",
                  "\r",
                  "// Save as COLLECTION variables (safer than globals)\r",
                  "if (accessToken) {\r",
                  "  pm.environment.set('accessToken', accessToken);\r",
                  "} else {\r",
                  "  pm.test('accessToken present', () => pm.expect.fail('data.accessToken missing'));\r",
                  "}\r",
                  "\r",
                  "if (refreshToken) {\r",
                  "  pm.environment.set('refreshToken', refreshToken);\r",
                  "} else {\r",
                  "  pm.test('refreshToken present', () => pm.expect.fail('data.refreshToken missing'));\r",
                  "}\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"{{adminEmail}}\",\r\n    \"password\": \"{{adminPassword}}\"\r\n}",
              "options": {
