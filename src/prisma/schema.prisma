datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Enables CREATE EXTENSION citext; for case-insensitive email & names
  extensions = [citext()]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator kysely {
  provider        = "prisma-kysely"
  output          = "../db/kysely"
  previewFeatures = ["postgresqlExtensions"]
  fileName        = "types.ts"
  enumFileName    = "enums.ts"
}

generator custom_kysely {
  provider        = "../generate_enums.sh"
  output          = "../db/kysely"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum OrderStatus {
  CREATED
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
  CASH
}

enum PaymentStatus {
  UNPAID
  PAID
  PROCESSING
  FAILED
}

enum ReferenceType {
  PRODUCT_TYPE
  GIFT_CARD
  MEMBERSHIP
  PACKAGE
}

enum PermissionFeature {
  USER
  PRODUCT
  PRODUCT_IMAGE
  BRAND
  CATEGORY
  ORDER
  ORDER_ITEM
  CART
  CART_ITEM
  ROLE_PERMISSION
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  LIST
  UPLOAD
  MANAGE
}

//////////////////////
// MODELS
//////////////////////

model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  // Case-insensitive unique email using citext
  email        String   @unique @db.Citext
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // relations
  userLocations            UserLocation[]
  refreshTokens            RefreshToken[]
  productsCreated          Product[]         @relation("productCreatedBy")
  productsUpdated          Product[]         @relation("productUpdatedBy")
  productImagesCreated     ProductImage[]    @relation("productImagesCreatedBy")
  productImagesUpdated     ProductImage[]    @relation("productImagesUpdatedBy")
  categoriesCreated        Category[]        @relation("categoryCreatedBy")
  categoriesUpdated        Category[]        @relation("categoryUpdatedBy")
  productCategoriesCreated ProductCategory[] @relation("productCategoryCreatedBy")
  productCategoriesUpdated ProductCategory[] @relation("productCategoryUpdatedBy")
  ordersUpdated            Order[]           @relation("orderUpdatedBy")
  brandsCreated            Brand[]           @relation("brandCreatedBy")
  brandsUpdated            Brand[]           @relation("brandUpdatedBy")
  cartSession              CartSession[]
  orders                   Order[]

  @@index([createdAt])
  @@index([deletedAt])
}

model UserLocation {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  phone   String @db.VarChar(32)
  address String @db.VarChar(255)

  // relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
}

model RolePermission {
  rolePermissionId  String            @id @default(uuid()) @db.Uuid
  role              UserRole          @default(USER)
  permissionFeature PermissionFeature @default(USER)
  permissionAction  PermissionAction  @default(READ)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@unique([role, permissionFeature, permissionAction])
}

model RefreshToken {
  token     String   @id @db.VarChar(1000)
  userId    String   @db.Uuid
  expiredAt DateTime
  createdAt DateTime @default(now())

  // relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiredAt])
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  // Unique, case-insensitive brand names
  brandName   String    @db.Citext
  description String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // relations
  products Product[]

  createdBy User? @relation("brandCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("brandUpdatedBy", fields: [updatedById], references: [id])

  @@unique([brandName])
  @@index([createdById])
  @@index([updatedById])
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  productName       String    @db.Citext
  productType       String    @db.VarChar(64) // TODO: convert to enum when values are fixed
  price             Decimal   @default(0) @db.Decimal(12, 2)
  quantity          Int       @default(0)
  usageInstructions String?   @db.VarChar(2000)
  description       String?   @db.VarChar(4000)
  ingredients       String?   @db.VarChar(2000)
  brandId           String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // relations
  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  categories ProductCategory[]

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdBy User? @relation("productCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("productUpdatedBy", fields: [updatedById], references: [id])

  // Avoid duplicate product names within a brand
  @@unique([brandId, productName])
  @@index([brandId])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
}

model ProductImage {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  imagePath   String    @db.VarChar(1024)
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  updatedAt   DateTime  @updatedAt
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  // relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdBy User? @relation("productImagesCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("productImagesUpdatedBy", fields: [updatedById], references: [id])

  // Prevent duplicate file paths
  @@unique([imagePath])
  @@index([productId])
  @@index([createdById])
  @@index([updatedById])
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  // Unique, case-insensitive category names
  categoryName String    @db.Citext
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // relations
  productCategories ProductCategory[]

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdBy User? @relation("categoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("categoryUpdatedBy", fields: [updatedById], references: [id])

  @@unique([categoryName])
  @@index([createdById])
  @@index([updatedById])
}

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  categoryId  String    @db.Uuid
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  updatedAt   DateTime  @updatedAt
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  // relations
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdBy User? @relation("productCategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("productCategoryUpdatedBy", fields: [updatedById], references: [id])

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@index([createdById])
  @@index([updatedById])
}

model CartSession {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  baseTotalPrice Decimal @default(0) @db.Decimal(12, 2)
  totalTax       Decimal @default(0) @db.Decimal(12, 2)

  // relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  // Enforce one active cart per user
  @@unique([userId])
  @@index([userId])
}

model CartItem {
  id            String        @id @default(uuid()) @db.Uuid
  cartSessionId String        @db.Uuid
  referenceId   String        @db.VarChar(255) // polymorphic, no relation
  referenceType ReferenceType
  quantity      Int           @default(1)
  note          String?       @db.VarChar(1000)

  // relations
  cartSession CartSession @relation(fields: [cartSessionId], references: [id], onDelete: Cascade)

  @@index([cartSessionId])
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  orderStatus    OrderStatus   @default(CREATED)
  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(UNPAID)
  paidAt         DateTime?
  evidencePath   String?       @db.VarChar(1024)
  totalTax       Decimal       @default(0) @db.Decimal(12, 2)
  baseTotalPrice Decimal       @default(0) @db.Decimal(12, 2)
  totalAmountDue Decimal       @default(0) @db.Decimal(12, 2)
  note           String?       @db.VarChar(2000)
  userPhone      String?       @db.VarChar(32)
  userAddress    String?       @db.VarChar(255)
  updatedById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // relations
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  updatedBy User?       @relation("orderUpdatedBy", fields: [updatedById], references: [id])

  @@index([userId])
  @@index([updatedById])
  @@index([createdAt])
}

model OrderItem {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  orderItemName String        @db.VarChar(255)
  referenceId   String        @db.VarChar(255) // polymorphic, no relation
  referenceType ReferenceType
  quantity      Int           @default(1)
  price         Decimal       @default(0) @db.Decimal(12, 2)
  note          String?       @db.VarChar(1000)

  // relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Avoid duplicate lines for the same referenced object
  @@unique([orderId, referenceId, referenceType])
  @@index([orderId])
}
