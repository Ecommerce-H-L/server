datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator kysely {
  provider        = "prisma-kysely"
  output          = "../db/kysely"
  previewFeatures = ["postgresqlExtensions"]
  fileName        = "types.ts"
  enumFileName    = "enums.ts"
}

generator custom_kysely {
  provider        = "../generate_enums.sh"
  output          = "../db/kysely"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum OrderStatus {
  CREATED
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
  CASH
}

enum PaymentStatus {
  UNPAID
  PAID
  PROCESSING
  FAILED
}

enum ReferenceType {
  PRODUCT_TYPE
  GIFT_CARD
  MEMBERSHIP
  PACKAGE
}

//////////////////////
// MODELS
//////////////////////

model User {
  userId       String   @id @db.VarChar
  firstName    String   @db.VarChar
  lastName     String   @db.VarChar
  email        String   @db.VarChar
  passwordHash String   @db.VarChar
  role         UserRole

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // relations
  userLocations            UserLocation[]
  refreshTokens            RefreshToken[]
  productsCreated          Product[]         @relation("productCreatedBy")
  productsUpdated          Product[]         @relation("productUpdatedBy")
  productImagesCreated     ProductImage[]    @relation("productImagesCreatedBy")
  productImagesUpdated     ProductImage[]    @relation("productImagesUpdatedBy")
  categoriesCreated        Category[]        @relation("categoryCreatedBy")
  categoriesUpdated        Category[]        @relation("categoryUpdatedBy")
  productCategoriesCreated ProductCategory[] @relation("productCategoryCreatedBy")
  productCategoriesUpdated ProductCategory[] @relation("productCategoryUpdatedBy")
  ordersUpdated            Order[]           @relation("orderUpdatedBy")
  brandsCreated            Brand[]           @relation("brandCreatedBy")
  brandsUpdated            Brand[]           @relation("brandUpdatedBy")
  cartSession              CartSession[]
  orders                   Order[]
}

model UserLocation {
  userLocationId String @id @db.VarChar
  userId         String @db.VarChar
  phone          String @db.VarChar
  address        String @db.VarChar

  // relations
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model RolePermission {
  rolePermissionId  String    @id @db.VarChar
  permissionFeature String    @db.VarChar // source says "enum" — make enum later if desired
  permissionAction  String    @db.VarChar // source says "enum" — make enum later if desired
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model RefreshToken {
  token     String   @id @db.VarChar
  userId    String   @db.VarChar
  expiredAt DateTime
  createdAt DateTime @default(now())

  // relations
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model Brand {
  brandId     String    @id @db.VarChar
  brandName   String    @db.VarChar
  description String?   @db.VarChar
  createdAt   DateTime  @default(now())
  createdById String?   @db.VarChar
  updatedById String?   @db.VarChar
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // relations
  products Product[]

  createdBy User? @relation("brandCreatedBy", fields: [createdById], references: [userId])
  updatedBy User? @relation("brandUpdatedBy", fields: [updatedById], references: [userId])
}

model Product {
  productId         String    @id @db.VarChar
  productName       String    @db.VarChar
  productType       String    @db.VarChar // source says "enum" — convert later if you have values
  price             Decimal   @db.Decimal(12, 2)
  quantity          Int
  usageInstructions String?   @db.VarChar
  description       String?   @db.VarChar
  ingredients       String?   @db.VarChar
  brandId           String?   @db.VarChar
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // relations
  brand      Brand?            @relation(fields: [brandId], references: [brandId], onDelete: SetNull)
  images     ProductImage[]
  categories ProductCategory[]

  createdById String? @db.VarChar
  updatedById String? @db.VarChar

  createdBy User? @relation("productCreatedBy", fields: [createdById], references: [userId])
  updatedBy User? @relation("productUpdatedBy", fields: [updatedById], references: [userId])

  @@index([brandId])
  @@index([createdById])
  @@index([updatedById])
}

model ProductImage {
  productImageId String    @id @db.VarChar
  productId      String    @db.VarChar
  imagePath      String    @db.VarChar
  createdAt      DateTime  @default(now())
  createdById    String?   @db.VarChar
  updatedAt      DateTime  @updatedAt
  updatedById    String?   @db.VarChar
  deletedAt      DateTime?

  // relations
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  createdBy User? @relation("productImagesCreatedBy", fields: [createdById], references: [userId])
  updatedBy User? @relation("productImagesUpdatedBy", fields: [updatedById], references: [userId])

  @@index([productId])
  @@index([createdById])
  @@index([updatedById])
}

model Category {
  categoryId   String    @id @db.VarChar
  categoryName String    @db.VarChar
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // relations
  productCategories ProductCategory[]

  createdById String? @db.VarChar
  updatedById String? @db.VarChar

  createdBy User? @relation("categoryCreatedBy", fields: [createdById], references: [userId])
  updatedBy User? @relation("categoryUpdatedBy", fields: [updatedById], references: [userId])

  @@map("category")
}

model ProductCategory {
  productCategoryId String    @id @db.VarChar
  productId         String    @db.VarChar
  categoryId        String    @db.VarChar
  createdAt         DateTime  @default(now())
  createdById       String?   @db.VarChar
  updatedAt         DateTime  @updatedAt
  updatedById       String?   @db.VarChar
  deletedAt         DateTime?

  // relations
  product  Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)

  createdBy User? @relation("productCategoryCreatedBy", fields: [createdById], references: [userId])
  updatedBy User? @relation("productCategoryUpdatedBy", fields: [updatedById], references: [userId])

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model CartSession {
  cartSessionId  String  @id @db.VarChar
  userId         String  @db.VarChar
  baseTotalPrice Decimal @db.Decimal(12, 2)
  totalTax       Decimal @db.Decimal(12, 2)

  // relations
  user  User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  cartItemId    String        @id @db.VarChar
  cartSessionId String        @db.VarChar
  referenceId   String        @db.VarChar // polymorphic, no relation
  referenceType ReferenceType
  quantity      Int
  note          String?       @db.VarChar

  // relations
  cartSession CartSession @relation(fields: [cartSessionId], references: [cartSessionId], onDelete: Cascade)

  @@index([cartSessionId])
}

model Order {
  orderId        String        @id @db.VarChar
  userId         String        @db.VarChar
  orderStatus    OrderStatus
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus
  paidAt         DateTime?
  evidencePath   String?       @db.VarChar
  totalTax       Decimal       @default(0) @db.Decimal(12, 2)
  baseTotalPrice Decimal       @db.Decimal(12, 2)
  totalAmountDue Decimal       @db.Decimal(12, 2)
  note           String?       @db.VarChar
  userPhone      String?       @db.VarChar
  userAddress    String?       @db.VarChar
  updatedById    String?       @db.VarChar
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // relations
  user      User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items     OrderItem[]
  updatedBy User?       @relation("orderUpdatedBy", fields: [updatedById], references: [userId])

  @@index([userId])
  @@index([updatedById])
}

model OrderItem {
  orderItemId   String        @id @db.VarChar
  orderId       String        @db.VarChar
  orderItemName String        @db.VarChar
  referenceId   String        @db.VarChar // polymorphic, no relation
  referenceType ReferenceType
  quantity      Int
  price         Decimal       @db.Decimal(12, 2)
  note          String?       @db.VarChar

  // relations
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId])
}
