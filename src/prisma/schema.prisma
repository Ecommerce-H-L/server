datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator kysely {
  provider        = "prisma-kysely"
  output          = "../db/kysely"
  previewFeatures = ["postgresqlExtensions"]
  fileName        = "types.ts"
  enumFileName    = "enums.ts"
}

generator custom_kysely {
  provider        = "../generate_enums.sh"
  output          = "../db/kysely"
  previewFeatures = ["postgresqlExtensions"]
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum OrderStatus {
  created
  payment_pending
  model User {
    user_id       String     @id @db.VarChar
    first_name    String      @db.VarChar
    last_name     String      @db.VarChar
    email         String      @db.VarChar
    password_hash String      @db.VarChar
    role          UserRole

    created_at    DateTime    @default(now())
    updated_at    DateTime    @updatedAt
    deleted_at    DateTime?

    // relations
    user_locations UserLocation[]
    refresh_tokens RefreshToken[]
    products_created Product[] @relation("product_createdBy")
    products_updated Product[] @relation("product_updatedBy")
    product_images_created ProductImages[] @relation("product_images_createdBy")
    product_images_updated ProductImages[] @relation("product_images_updatedBy")
    categories_created Category[] @relation("category_createdBy")
    categories_updated Category[] @relation("category_updatedBy")
    product_categories_created ProductCategory[] @relation("product_category_createdBy")
    product_categories_updated ProductCategory[] @relation("product_category_updatedBy")
    orders_updated Order[] @relation("order_updatedBy")

    // brand relations (opposite sides for brand.createdBy / brand.updatedBy)
    brands_created Brand[] @relation("brand_createdBy")
    brands_updated Brand[] @relation("brand_updatedBy")

    // cart & order relations
    cart_sessions CartSession[]
    orders Order[]

    @@map("user")
  }

model user {
  user_id       String    @id @db.VarChar
  first_name    String    @db.VarChar
  last_name     String    @db.VarChar
  email         String    @db.VarChar
  password_hash String    @db.VarChar
  role          user_role

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // relations
  user_locations             user_location[]
  refresh_tokens             refresh_token[]
  products_created           product[]          @relation("product_createdBy")
  products_updated           product[]          @relation("product_updatedBy")
  product_images_created     product_images[]   @relation("product_images_createdBy")
  product_images_updated     product_images[]   @relation("product_images_updatedBy")
  categories_created         category[]         @relation("category_createdBy")
  categories_updated         category[]         @relation("category_updatedBy")
  product_categories_created product_category[] @relation("product_category_createdBy")
  product_categories_updated product_category[] @relation("product_category_updatedBy")
  orders_updated             order[]            @relation("order_updatedBy")

  // brand relations (opposite sides for brand.createdBy / brand.updatedBy)
  brands_created brand[] @relation("brand_createdBy")
  brands_updated brand[] @relation("brand_updatedBy")

  // cart & order relations
  cart_sessions cart_session[]
  orders        order[]

  @@map("user")
}

model UserLocation {
  user_location_id String  @id @db.VarChar
  user_id          String  @db.VarChar
  phone            String  @db.VarChar
  address          String  @db.VarChar

  // relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_location")
}

model RolePermission {
  role_permission_id String   @id @db.VarChar
  permission_feature String   @db.VarChar // source says "enum" — make enum later if desired
  permission_action  String   @db.VarChar // source says "enum" — make enum later if desired
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted_at         DateTime?

  @@map("role_permission")
}

model RefreshToken {
  token      String   @id @db.VarChar
  user_id    String   @db.VarChar
  expired_at DateTime
  created_at DateTime @default(now())

  // relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_token")
}

model Brand {
  brand_id    String   @id @db.VarChar
  brand_name  String   @db.VarChar
  description String?  @db.VarChar
  created_at  DateTime @default(now())
  created_by  String?  @db.VarChar
  updated_at  DateTime @updatedAt
  updated_by  String?  @db.VarChar
  deleted_at  DateTime?

  // relations
  products Product[]

  createdBy User? @relation("brand_createdBy", fields: [created_by], references: [user_id])
  updatedBy User? @relation("brand_updatedBy", fields: [updated_by], references: [user_id])

  @@map("brand")
}

model Product {
  product_id          String   @id @db.VarChar
  product_name        String   @db.VarChar
  product_type        String   @db.VarChar // source says "enum" — convert later if you have values
  price               Decimal  @db.Decimal(12, 2)
  quantity            Int
  usage_instructions  String?  @db.VarChar
  description         String?  @db.VarChar
  ingredients         String?  @db.VarChar
  brand_id            String?  @db.VarChar
  created_at          DateTime @default(now())
  created_by          String?  @db.VarChar
  updated_at          DateTime @updatedAt
  updated_by          String?  @db.VarChar
  deleted_at          DateTime?

  // relations
  brand  Brand? @relation(fields: [brand_id], references: [brand_id])
  images ProductImages[]
  categories ProductCategory[]

  createdBy User? @relation("product_createdBy", fields: [created_by], references: [user_id])
  updatedBy User? @relation("product_updatedBy", fields: [updated_by], references: [user_id])

  @@index([brand_id])
  @@index([created_by])
  @@index([updated_by])
  @@map("product")
}

model ProductImages {
  product_image_id String   @id @db.VarChar
  product_id       String   @db.VarChar
  image_path       String   @db.VarChar
  created_at       DateTime @default(now())
  created_by       String?  @db.VarChar
  updated_at       DateTime @updatedAt
  updated_by       String?  @db.VarChar
  deleted_at       DateTime?

  // relations
  product Product @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  createdBy User? @relation("product_images_createdBy", fields: [created_by], references: [user_id])
  updatedBy User? @relation("product_images_updatedBy", fields: [updated_by], references: [user_id])

  @@index([product_id])
  @@index([created_by])
  @@index([updated_by])
  @@map("product_images")
}

model Category {
  category_id   String   @id @db.VarChar
  category_name String   @db.VarChar
  created_at    DateTime @default(now())
  created_by    String?  @db.VarChar
  updated_at    DateTime @updatedAt
  updated_by    String?  @db.VarChar
  deleted_at    DateTime?

  // relations
  product_categories ProductCategory[]

  createdBy User? @relation("category_createdBy", fields: [created_by], references: [user_id])
  updatedBy User? @relation("category_updatedBy", fields: [updated_by], references: [user_id])

  @@map("category")
}

model ProductCategory {
  product_category_id String   @id @db.VarChar
  product_id          String   @db.VarChar
  category_id         String   @db.VarChar
  created_at          DateTime @default(now())
  created_by          String?  @db.VarChar
  updated_at          DateTime @updatedAt
  updated_by          String?  @db.VarChar
  deleted_at          DateTime?

  // relations
  product  Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [category_id], onDelete: Cascade)

  createdBy User? @relation("product_category_createdBy", fields: [created_by], references: [user_id])
  updatedBy User? @relation("product_category_updatedBy", fields: [updated_by], references: [user_id])

  @@unique([product_id, category_id])
  @@index([product_id])
  @@index([category_id])
  @@map("product_category")
}

model Order {
  order_id         String         @id @db.VarChar
  user_id          String         @db.VarChar
  order_status     OrderStatus
  payment_method   PaymentMethod
  payment_status   PaymentStatus
  paid_at          DateTime?
  evidence_path    String?        @db.VarChar
  total_tax        Decimal        @default(0) @db.Decimal(12, 2)
  base_total_price Decimal        @db.Decimal(12, 2)
  total_amount_due Decimal        @db.Decimal(12, 2)
  note             String?        @db.VarChar
  user_phone       String?        @db.VarChar
  user_address     String?        @db.VarChar
  updated_by       String?        @db.VarChar
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  deleted_at       DateTime?

  // relations
  user  User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  items OrderItem[]

  updatedBy User? @relation("order_updatedBy", fields: [updated_by], references: [user_id])

  @@index([user_id])
  @@index([updated_by])
  @@map("order")
}
model order {
  order_id         String         @id @db.VarChar
  user_id          String         @db.VarChar
  order_status     order_status
  payment_method   payment_method
  payment_status   payment_status
  paid_at          DateTime?
  evidence_path    String?        @db.VarChar
  total_tax        Decimal        @default(0) @db.Decimal(12, 2)
  base_total_price Decimal        @db.Decimal(12, 2)
  total_amount_due Decimal        @db.Decimal(12, 2)
  note             String?        @db.VarChar
  user_phone       String?        @db.VarChar
  user_address     String?        @db.VarChar
  updated_by       String?        @db.VarChar
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  deleted_at       DateTime?

  // relations
  user  user         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  items order_item[]

  updatedBy user? @relation("order_updatedBy", fields: [updated_by], references: [user_id])

  @@index([user_id])
  @@index([updated_by])
  @@map("order")
}

model OrderItem {
  order_item_id   String         @id @db.VarChar
  order_id        String         @db.VarChar
  order_item_name String         @db.VarChar
  reference_id    String         @db.VarChar // polymorphic, no relation
  reference_type  ReferenceType
  quantity        Int
  price           Decimal        @db.Decimal(12, 2)
  note            String?        @db.VarChar

  // relations
  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_item")
}
